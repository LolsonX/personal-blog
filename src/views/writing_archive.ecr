<%= header_html %>
<main class="journal-main journal-main--archive">
  <section class="writing-archive" aria-labelledby="archive-heading">
    <p class="eyebrow">From the notebook</p>
    <h1 class="display-heading" id="archive-heading">Writing</h1>
    <p class="writing-archive__intro">Notes on development, ideas worth exploring, and things I find useful.</p>
    <%= writing_list_html %>
    <% if next_page_url %>
      <nav class="archive-pagination" aria-label="Writing archive pages">
        <a class="archive-pagination__next" href="<%= next_page_url %>">Older posts <span aria-hidden="true">→</span></a>
      </nav>
    <% end %>
  </section>
</main>
<%= footer_html %>
