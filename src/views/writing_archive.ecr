<%= header_html %>
<main class="journal-main journal-main--archive">
  <section class="writing-archive" aria-labelledby="archive-heading">
    <h1 class="display-heading" id="archive-heading">Writing</h1>
    <%= writing_list_html %>
    <% if next_page_url %>
      <nav class="archive-pagination" aria-label="Writing archive pages">
        <a class="archive-pagination__next inline-flex items-center rounded border border-accent text-accent px-5 py-3 font-medium no-underline transition-colors hover:bg-accent hover:text-on-accent focus:outline-accent" href="<%= next_page_url %>">Older posts</a>
      </nav>
    <% end %>
  </section>
</main>
<%= footer_html %>
