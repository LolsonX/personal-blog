<div class="journal-hero__story">
  <h1 class="display-heading" id="headline"><%= safe_given_name %> <em>“<%= safe_handle %>”</em><br><%= safe_family_name %></h1>
  <p class="journal-hero__role"><%= safe_role %></p>
  <p class="hero__intro"><%= safe_bio %></p>
  <a class="text-link inline-flex items-center gap-2 rounded border border-accent text-accent px-5 py-3 font-medium no-underline transition-colors hover:bg-accent hover:text-on-accent focus:outline-accent" href="/writing">Read my writing</a>
</div>
