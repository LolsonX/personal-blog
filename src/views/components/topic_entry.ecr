<article class="topic-entry">
  <span class="topic-entry__number" aria-hidden="true"><%= number %></span>
  <div>
    <p class="feature__label"><%= safe_label %></p>
    <h3 class="feature__title"><%= safe_title %></h3>
    <p class="feature__description"><%= safe_description %></p>
  </div>
  <span class="topic-entry__arrow" aria-hidden="true">↗</span>
</article>
