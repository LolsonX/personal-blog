# Application environment. This file is a documentation template only.
# Values are NOT read from the repository: the "Deploy environment" workflow
# maps variables and secrets from the GitHub `production` environment into the
# file written on the hosting server.
#
# Public variables:  HOST, PORT, DATABASE_URL
# Private secrets:   SESSION_SECRET, EDITOR_USERNAME, EDITOR_PASSWORD_HASH

# Network interface the app binds to.
HOST=0.0.0.0

# TCP port the app listens on (reverse proxy forwards here).
PORT=3000

# SQLite connection string. WAL, busy timeout, and foreign keys are enabled.
DATABASE_URL=sqlite3:///var/lib/core-code/core-code.db?journal_mode=wal&busy_timeout=5000&foreign_keys=on

# Secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me

# Sign-in name for the single editor account.
EDITOR_USERNAME=change-me

# Bcrypt hash of the editor password. Generate with:
#   crystal eval 'require "crypto/bcrypt/password"; puts Crypto::Bcrypt::Password.create(ARGV[0]).to_s' -- 'your-password'
EDITOR_PASSWORD_HASH=change-me
